// Fixture for tw-bindings_test.zena: an extension class declared
// before its parent, and a specialized parent before a generic type
// its constructor names.

@external("tw:js/global", "make()", "tw")
declare function make(): externref;

export extension class Child extends Parent {
  new() : super.wrap(make());
}

export extension class Parent on externref {
  new wrap(value: externref) : super(value);
}

export extension class Digest extends Stream<externref | null> {
  new() : super.wrap(make());
}

export extension class Stream<W> on externref {
  new wrap(value: externref) : super(value);
  new withSink(sink: Sink<externref | null>) : super(streamNew<W>(sink));
}

export extension class Sink<W> on externref {}

@external("tw:js/global", "Stream.new<{W}>(Sink<Any?>)", "tw")
declare function streamNew<W>(sink: Sink<externref | null>): externref;

export function main(s: Sink<externref | null>): i32 {
  let c = new Child();
  let d = new Digest();
  let t = new Stream<externref | null>.withSink(s);
  return 0;
}
