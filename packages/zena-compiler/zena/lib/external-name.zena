/**
 * `@external` names templated per instantiation of a generic declare
 * function. A `{T}` in the name stands for the spelling of `T`'s type
 * argument, so each monomorphized instantiation imports under a name of
 * its own: `Map#get<{K},{V}>(K)` at `<String, f64>` imports
 * `Map#get<str,f64>(K)`. The spellings are the ts-gen IR's canonical
 * type spellings, which have no spaces, so a bridge generated from the
 * IR can derive the concrete variant from the import name alone.
 */
import {
  Type, I32Type, U32Type, I64Type, U64Type, F32Type, F64Type, U8Type,
  U16Type, I8Type, I16Type, BooleanType, VoidType, NullType, ExternRefType,
  ArrayType, TupleType, InlineTupleType, UnionType, ClassType, FunctionType,
  TypeParameterType, TypeAliasType, EnumType, unwrapAliases,
} from './types.zena';
import { Decorator, DeclareFunction, decoratorStringArg } from './ast.zena';
import { WellKnown, isWellKnown } from './well-known.zena';

/**
 * An `@external` name split at its placeholders: `pieces` is the literal
 * text around them, one more piece than there are `holes`. A malformed
 * name has `error` set and no meaningful pieces.
 */
export final class ExternalNameTemplate {
  pieces: GrowableArray<String>;
  holes: GrowableArray<String>;
  error: String | null;
  new(this.pieces, this.holes, this.error);
}

function templateError(message: String) {
  return new ExternalNameTemplate(new Array<String>(), new Array<String>(), message);
}

export function parseExternalNameTemplate(name: String): ExternalNameTemplate {
  let pieces = new Array<String>();
  let holes = new Array<String>();
  var piece = "";
  var from = 0;
  var i = 0;
  while (i < name.length) {
    let c = name.getByteAt(i);
    // `{{` and `}}` are a literal brace, as a name the IR spells with one
    // (an inline object type) needs.
    if ((c == 123 || c == 125) && i + 1 < name.length && name.getByteAt(i + 1) == c) {
      piece = `${piece}${name.sliceBytes(from, i + 1)}`;
      i += 2;
      from = i;
      continue;
    }
    if (c == 125) { // '}'
      return templateError("Unmatched '}'");
    }
    if (c != 123) { // '{'
      i += 1;
      continue;
    }
    var j = i + 1;
    while (j < name.length && name.getByteAt(j) != 125) {
      if (name.getByteAt(j) == 123) {
        return templateError("Nested '{'");
      }
      j += 1;
    }
    if (j >= name.length) {
      return templateError("Unclosed '{'");
    }
    if (j == i + 1) {
      return templateError("Empty '{}'");
    }
    pieces.push(`${piece}${name.sliceBytes(from, i)}`);
    piece = "";
    holes.push(name.sliceBytes(i + 1, j));
    from = j + 1;
    i = j + 1;
  }
  pieces.push(`${piece}${name.sliceBytes(from, name.length)}`);
  return new ExternalNameTemplate(pieces, holes, null);
}

/**
 * A non-generic declaration's import name: its `@external` name with
 * `{{` and `}}` read as braces. It has no placeholders (the checker
 * reports any), so only the literal text is left.
 */
export function literalExternalName(name: String): String {
  let template = parseExternalNameTemplate(name);
  if (template.error != null || template.holes.length > 0) {
    return name;
  }
  return template.pieces[0];
}

function joinSpellings(types: Array<Type>, isString: (ct: ClassType) => boolean): String | null {
  var out = "";
  for (var i = 0; i < types.length; i += 1) {
    let spelled = irTypeSpelling(types[i], isString);
    if (spelled == null) {
      return null;
    }
    out = if (i == 0) spelled else `${out},${spelled}`;
  }
  return out;
}

function namedSpelling(name: String, typeArguments: Array<Type> | null,
    isString: (ct: ClassType) => boolean): String | null {
  if (typeArguments == null || typeArguments.length == 0) {
    return name;
  }
  let args = joinSpellings(typeArguments, isString);
  if (args == null) {
    return null;
  }
  return `${name}<${args}>`;
}

function tupleSpelling(elementTypes: Array<Type>,
    isString: (ct: ClassType) => boolean): String | null {
  if (elementTypes.length == 0) {
    return null;
  }
  let elements = joinSpellings(elementTypes, isString);
  if (elements == null) {
    return null;
  }
  return if (elementTypes.length == 1) {
    `(${elements},)`
  } else {
    `(${elements})`
  };
}

function suffixSpelling(t: Type, suffix: String,
    isString: (ct: ClassType) => boolean): String | null {
  let spelled = irTypeSpelling(t, isString);
  if (spelled == null) {
    return null;
  }
  return `${spelled}${suffix}`;
}

/** `T | null` is the IR's `T?`; the IR has no other unions. */
function nullableSpelling(types: Array<Type>,
    isString: (ct: ClassType) => boolean): String | null {
  if (types.length != 2) {
    return null;
  }
  if (types[0] is NullType) {
    return suffixSpelling(types[1], "?", isString);
  }
  if (types[1] is NullType) {
    return suffixSpelling(types[0], "?", isString);
  }
  let payload = optionPayload(types);
  if (payload != null) {
    return suffixSpelling(payload, "?", isString);
  }
  return null;
}

/**
 * `T` for the arms of an `Option<T>`, `Some<T> | None`, which a `tw`
 * import carries as the IR's `T?`.
 */
export function optionPayload(types: Array<Type>): Type | null {
  if (types.length != 2) {
    return null;
  }
  var payload: Type | null = null;
  var hasNone = false;
  for (let t in types) {
    if (t is ClassType) {
      let typeArguments = t.typeArguments;
      if (isWellKnown(WellKnown.SomeClass, t.name, t.sourcePath) &&
          typeArguments != null && typeArguments.length == 1) {
        payload = typeArguments[0];
      } else if (isWellKnown(WellKnown.NoneClass, t.name, t.sourcePath)) {
        hasNone = true;
      }
    }
  }
  return if (hasNone) payload else null;
}

function functionSpelling(ft: FunctionType,
    isString: (ct: ClassType) => boolean): String | null {
  let typeParameters = ft.typeParameters;
  if (typeParameters != null && typeParameters.length > 0) {
    return null;
  }
  let params = if (ft.parameters.length == 0) {
    ""
  } else {
    joinSpellings(ft.parameters, isString)
  };
  if (params == null) {
    return null;
  }
  if (ft.returnType is VoidType) {
    return `fn(${params})`;
  }
  let result = irTypeSpelling(ft.returnType, isString);
  if (result == null) {
    return null;
  }
  return `fn(${params})->${result}`;
}

/**
 * The name a declaration's `@spelling("<IR name>")` gives it, if any.
 */
export function declaredSpelling(decorators: GrowableArray<Decorator>): String | null {
  for (let dec in decorators) {
    if (dec.name == "spelling" && dec.args.length == 1) {
      return decoratorStringArg(dec, 0);
    }
  }
  return null;
}

/**
 * The ts-gen IR spelling of `t`, or null when the IR has no spelling for
 * it. A distinct type spells as its name, which is how a binding names
 * the IR declaration it stands for (`distinct type Request = externref`
 * spells `Request`), and a class or enum as its `@spelling` if it has
 * one. `isString` tells the standard library's String, which is the IR's
 * unboxed `str`.
 */
export function irTypeSpelling(t: Type, isString: (ct: ClassType) => boolean): String | null {
  return match (t) {
    case I32Type: "i32"
    case U32Type: "u32"
    case I64Type: "i64"
    case U64Type: "u64"
    case F32Type: "f32"
    case F64Type: "f64"
    case U8Type: "u8"
    case U16Type: "u16"
    case I8Type: "i8"
    case I16Type: "i16"
    case BooleanType: "bool"
    case VoidType: "void"
    case ExternRefType: "Any"
    case ClassType as ct: {
      let typeArguments = ct.typeArguments;
      if (isString(ct)) {
        "str"
      } else if (ct.name == "array" && typeArguments != null && typeArguments.length == 1) {
        suffixSpelling(typeArguments[0], "[]", isString)
      } else {
        namedSpelling((ct.genericSource ?? ct).irSpelling ?? ct.name, typeArguments, isString)
      }
    }
    case ArrayType {elementType}: suffixSpelling(elementType, "[]", isString)
    case TupleType {elementTypes, row}: {
      if (row != null) null else tupleSpelling(elementTypes, isString)
    }
    case InlineTupleType {elementTypes}: tupleSpelling(elementTypes, isString)
    case UnionType {types}: nullableSpelling(types, isString)
    case FunctionType as ft: functionSpelling(ft, isString)
    case EnumType as et: declaredSpelling(et.declaration.decorators) ?? et.name
    case TypeAliasType as ta: {
      if (ta.isDistinct) {
        namedSpelling(ta.name, ta.typeArguments, isString)
      } else {
        let target = unwrapAliases(ta);
        if (target is TypeAliasType && !target.isDistinct) {
          null
        } else {
          irTypeSpelling(target, isString)
        }
      }
    }
    case _: null
  };
}

/**
 * Whether a value of type parameter `name` crosses `ft`'s import: as a
 * parameter or the result, or an element or `Option` of one. Only spelled, as the
 * argument of a host class such as `JsPromise<T>`, it can be any type
 * with a spelling.
 */
export function crossesAsValue(name: String, ft: FunctionType): boolean {
  for (let p in ft.parameters) {
    if (valueMentions(p, name)) {
      return true;
    }
  }
  return valueMentions(ft.returnType, name);
}

/**
 * Whether type parameter `name` occurs inside an array or tuple of a
 * value crossing `ft`'s import, where its values cross as a field or
 * element: in the Zena layout of its type argument rather than the IR
 * wire of the type it spells.
 */
export function crossesNested(name: String, ft: FunctionType): boolean {
  for (let p in ft.parameters) {
    if (nestedMentions(p, name, false)) {
      return true;
    }
  }
  return nestedMentions(ft.returnType, name, false);
}

/**
 * The element type of an array, a `FixedArray` (an extension class on
 * one) included, or null.
 */
function arrayElement(t: Type): Type | null {
  return match (t) {
    case ArrayType {elementType}: elementType
    case ClassType as ct: {
      let typeArguments = ct.typeArguments;
      let onType = ct.onType;
      if (ct.name == "array" && typeArguments != null && typeArguments.length == 1) {
        typeArguments[0]
      } else if (ct.isExtension && onType != null) {
        arrayElement(onType)
      } else {
        null
      }
    }
    case _: null
  };
}

function nestedMentions(t: Type, name: String, inside: boolean): boolean {
  let element = arrayElement(t);
  if (element != null) {
    return nestedMentions(element, name, true);
  }
  return match (t) {
    case TypeParameterType as tp: inside && tp.name == name
    case ClassType as ct: {
      let typeArguments = ct.typeArguments;
      if (isWellKnown(WellKnown.SomeClass, ct.name, ct.sourcePath) &&
          typeArguments != null && typeArguments.length == 1) {
        nestedMentions(typeArguments[0], name, inside)
      } else {
        false
      }
    }
    case TypeAliasType as ta: !ta.isDistinct && nestedMentions(unwrapAliases(ta), name, inside)
    case UnionType {types}: nestedMentionsAny(types, name, inside)
    case TupleType {elementTypes}: nestedMentionsAny(elementTypes, name, true)
    case InlineTupleType {elementTypes}: nestedMentionsAny(elementTypes, name, inside)
    case _: false
  };
}

function nestedMentionsAny(ts: Array<Type>, name: String, inside: boolean): boolean {
  for (let t in ts) {
    if (nestedMentions(t, name, inside)) {
      return true;
    }
  }
  return false;
}

/**
 * Why `t` doesn't cross as a field or element of a `tw` import's value,
 * or null when its Zena layout is its wire: a `String` is a struct there
 * rather than its JS string handle, and an `Option` a class rather than
 * the IR's `T?`.
 */
export function nestedCrossingProblem(t: Type, isString: (ct: ClassType) => boolean): String | null {
  let element = arrayElement(t);
  if (element != null) {
    return nestedCrossingProblem(element, isString);
  }
  if (t is UnionType) {
    if (optionPayload(t.types) != null) {
      return "is an Option, which crosses inside an array or tuple as a Zena class rather than the IR's T?";
    }
    return nestedProblemAll(t.types, isString);
  }
  return match (t) {
    case ClassType as ct: {
      if (isString(ct)) {
        "is a String, which crosses inside an array or tuple as a Zena struct rather than its JS string handle"
      } else {
        null
      }
    }
    case TupleType {elementTypes}: nestedProblemAll(elementTypes, isString)
    case TypeAliasType as ta: {
      if (ta.isDistinct) null else nestedCrossingProblem(unwrapAliases(ta), isString)
    }
    case _: null
  };
}

function nestedProblemAll(ts: Array<Type>, isString: (ct: ClassType) => boolean): String | null {
  for (let t in ts) {
    let problem = nestedCrossingProblem(t, isString);
    if (problem != null) {
      return problem;
    }
  }
  return null;
}

/**
 * Why type argument `t` for `name` doesn't cross `ft`'s `tw` import, or
 * null when it does.
 */
export function twArgumentProblem(name: String, ft: FunctionType, t: Type,
    isString: (ct: ClassType) => boolean): String | null {
  let problem = twCrossingProblem(t, isString);
  if (problem != null) {
    return problem;
  }
  if (crossesNested(name, ft)) {
    return nestedCrossingProblem(t, isString);
  }
  // A whole array's elements cross as elements.
  let element = arrayElement(t);
  return if (element != null) nestedCrossingProblem(element, isString) else null;
}

function valueMentions(t: Type, name: String): boolean {
  let element = arrayElement(t);
  if (element != null) {
    return valueMentions(element, name);
  }
  return match (t) {
    case TypeParameterType as tp: tp.name == name
    case ArrayType {elementType}: valueMentions(elementType, name)
    case ClassType as ct: {
      let typeArguments = ct.typeArguments;
      (ct.name == "array" || isWellKnown(WellKnown.SomeClass, ct.name, ct.sourcePath)) &&
          typeArguments != null && typeArguments.length == 1 &&
          valueMentions(typeArguments[0], name)
    }
    case TypeAliasType as ta: !ta.isDistinct && valueMentions(unwrapAliases(ta), name)
    case UnionType {types}: valueMentionsAny(types, name)
    case TupleType {elementTypes}: valueMentionsAny(elementTypes, name)
    case InlineTupleType {elementTypes}: valueMentionsAny(elementTypes, name)
    case _: false
  };
}

function valueMentionsAny(ts: Array<Type>, name: String): boolean {
  for (let t in ts) {
    if (valueMentions(t, name)) {
      return true;
    }
  }
  return false;
}

/**
 * Why a `tw` import's type argument `t` doesn't cross as the IR type it
 * spells, or null when it does. A Zena class other than an extension
 * class is a Zena struct, which the bridge knows nothing of, and a type
 * with no spelling names no IR type at all.
 */
export function twCrossingProblem(t: Type, isString: (ct: ClassType) => boolean): String | null {
  if (irTypeSpelling(t, isString) == null) {
    return "has no ts-gen IR spelling";
  }
  return structIn(t, isString);
}

function structIn(t: Type, isString: (ct: ClassType) => boolean): String | null {
  if (t is UnionType) {
    let payload = optionPayload(t.types);
    if (payload != null) {
      return structIn(payload, isString);
    }
  }
  return match (t) {
    case ClassType as ct: {
      if (!ct.isExtension && !isString(ct) && ct.name != "array") {
        `is the Zena class '${ct.name}', not a host type`
      } else {
        let typeArguments = ct.typeArguments;
        if (typeArguments != null) structInAll(typeArguments, isString) else null
      }
    }
    case ArrayType {elementType}: structIn(elementType, isString)
    case UnionType {types}: structInAll(types, isString)
    case TupleType {elementTypes}: structInAll(elementTypes, isString)
    case InlineTupleType {elementTypes}: structInAll(elementTypes, isString)
    case TypeAliasType as ta: {
      if (ta.isDistinct) null else structIn(unwrapAliases(ta), isString)
    }
    case _: null
  };
}

function structInAll(ts: Array<Type>, isString: (ct: ClassType) => boolean): String | null {
  for (let t in ts) {
    let problem = structIn(t, isString);
    if (problem != null) {
      return problem;
    }
  }
  return null;
}

/**
 * `template` with each placeholder replaced by the spelling of its type
 * argument. Throws when a placeholder names none of `typeParameters` or
 * an argument has no IR spelling: the checker reports the first at the
 * declaration, and the second depends on the instantiation.
 */
export function renderExternalName(template: ExternalNameTemplate,
    functionName: String, typeParameters: Array<TypeParameterType> | null,
    typeArguments: Array<Type>, isString: (ct: ClassType) => boolean,
    decorator: String = "external"): String {
  var out = template.pieces[0];
  for (var h = 0; h < template.holes.length; h += 1) {
    let hole = template.holes[h];
    var index = -1;
    if (typeParameters != null) {
      for (var p = 0; p < typeParameters.length; p += 1) {
        if (typeParameters[p].name == hole) {
          index = p;
        }
      }
    }
    if (index < 0 || index >= typeArguments.length) {
      throw new Error(`'{${hole}}' in the @${decorator} name of '${functionName}' names no type parameter`);
    }
    let spelled = irTypeSpelling(typeArguments[index], isString);
    if (spelled == null) {
      throw new Error(`The type argument for '${hole}' of '${functionName}' has no ts-gen IR spelling for its @${decorator} name`);
    }
    out = `${out}${spelled}${template.pieces[h + 1]}`;
  }
  return out;
}

/**
 * What a declare function's `@external` decorator names. `name` is the
 * written name, which for a generic declaration is a template
 * (external-name.zena).
 */
export final class ExternalImportSpec {
  module: String;
  name: String;
  isAsync: boolean;
  canonType: String;
  /**
   * `tw`: the provider is a ts-gen `tw` bridge, a Wasm module rather
   * than JS. Reference results cross as their own types, and a `String`
   * crosses as its JS string handle (the IR's `str` on the host carrier).
   */
  isTw: boolean;
  /**
   * `throws:<key>`: the import throws the `tw` tag `key`, which its
   * wrapper catches and throws as the tag's class.
   */
  var twThrows: String | null = null;
  new(this.module, this.name, this.isAsync, this.canonType, this.isTw);
}

/**
 * The options of a `tw` export, `"tw"` or `"tw, throws:<key>"`: the
 * thrown tag's key, empty for none, or null when they're neither.
 */
export function twExportOptions(raw: String): String | null {
  if (raw == "tw") {
    return "";
  }
  let prefix = "tw, throws:";
  if (raw.startsWith(prefix) && raw.length > prefix.length) {
    return raw.sliceBytes(prefix.length, raw.length);
  }
  return null;
}

/** The `@external` decorator of `decl`, or null when it has none. */
export function externalImportSpec(decl: DeclareFunction): ExternalImportSpec | null {
  for (let dec in decl.decorators) {
    if (dec.name != "external") {
      continue;
    }
    if (dec.args.length != 2 && dec.args.length != 3) {
      throw new Error("External decorator must have two or three arguments");
    }
    var isAsync = false;
    var isTw = false;
    var twThrows: String | null = null;
    var canonType = "";
    // A third argument is the import's canonical options, comma
    // separated. `async` is one; a WIT type spelling (`stream<u8>`,
    // `future:<interface>#<payload>`) names the type a typed
    // canonical builtin operates on. The rest of the canonical
    // option space (memory, realloc, string-encoding) is the
    // compiler's business rather than the program's, because only
    // the compiler knows where the memory lives. The split is
    // depth-aware: a future payload like `result<a, b>` carries
    // commas of its own, so only depth-zero commas separate.
    if (dec.args.length == 3) {
      let raw = decoratorStringArg(dec, 2) ?? "";
      let optionList = new Array<String>();
      var depth = 0;
      var from = 0;
      for (var oi = 0; oi <= raw.length; oi += 1) {
        if (oi < raw.length) {
          let c = raw.getByteAt(oi);
          if (c == 60) { depth += 1; continue; } // '<'
          if (c == 62) { depth -= 1; continue; } // '>'
          if (c != 44 || depth > 0) { continue; } // ','
        }
        var piece = raw.sliceBytes(from, oi);
        while (piece.startsWith(" ")) {
          piece = piece.sliceBytes(1, piece.length);
        }
        optionList.push(piece);
        from = oi + 1;
      }
      for (let option in optionList) {
        if (option == "async") {
          isAsync = true;
        } else if (option == "tw") {
          isTw = true;
        } else if (option.startsWith("throws:") && option.length > 7) {
          twThrows = option.sliceBytes(7, option.length);
        } else if (option.startsWith("stream") ||
            option.startsWith("future") ||
            option.startsWith("resource:") ||
            option.startsWith("return:")) {
          canonType = option;
        } else if (option != "") {
          throw new Error(
            "Unknown @external option '" + option + "' on '" +
            decl.name.name + "' (expected 'async', a stream/" +
            "future type like 'stream<u8>', 'tw', a " +
            "'resource:<interface>#<name>' reference, or a " +
            "'return:<interface>#<type>' result type)");
        }
      }
    }
    let spec = new ExternalImportSpec(decoratorStringArg(dec, 0) ?? "",
        decoratorStringArg(dec, 1) ?? "", isAsync, canonType, isTw);
    spec.twThrows = if (isTw) twThrows else null;
    return spec;
  }
  return null;
}
