/**
 * Shapes ts-gen's Zena bindings rely on, each of which once failed to
 * compile on `-t js`.
 */

import { suite, test } from 'zena:test';
import { equal, isTrue } from 'zena:assert';
import { readFileSync } from 'zena:fs';
import { compileFile } from '../lib/compile-file.zena';
import { stdlibRoot } from './test-utils.zena';

/** Compiles a fixture in `test-files/` to WAT and returns the text. */
function compileWat(name: String): String {
  let entry = `packages/zena-compiler/test-files/${name}.zena`;
  let outPath = `packages/zena-compiler/zena/out/${name}.wat`;
  equal(compileFile({entry, outPath, target: 'js', stdlibRoot}), 0);
  return readFileSync(outPath);
}

/** Whether the WAT exports `func` as `name`, at the function type `sig`. */
function exportsAt(wat: String, name: String, func: String, sig: String): boolean {
  if (!wat.contains(`(export "${name}" (func $${func}))`)) {
    return false;
  }
  for (var n = 0; n < 64; n += 1) {
    if (wat.contains(`(func $${func} (type ${n})`)) {
      return wat.contains(`(type (;${n};) (func ${sig}))`);
    }
  }
  return false;
}

/** Whether the WAT imports `name` at the function type `sig`. */
function importsAt(wat: String, name: String, sig: String): boolean {
  for (var n = 0; n < 64; n += 1) {
    if (wat.contains(`"${name}" (func (type ${n}))`)) {
      return wat.contains(`(type (;${n};) (func ${sig}))`);
    }
  }
  return false;
}

export let tests = suite('tw bindings', () => {
  test('generic imports instantiate from generic extension members', (ctx) => {
    let wat = compileWat('extension-generic-external');
    for (let want in [
      '"Map.new<str,f64>()"',
      '"Map#get<str,f64>(K)"',
      '"Map.of<i32>(T)"',
    ]) {
      isTrue(wat.contains(want), `missing ${want}`);
    }
  });

  test('extension classes declared before their parents', (ctx) => {
    compileWat('extension-declaration-order');
  });

  test('a subclass redeclares its parent accessor', (ctx) => {
    let wat = compileWat('extension-accessor-override');
    isTrue(wat.contains('"BucketOptions#get:onlyIf()"'), 'the subclass getter');
    isTrue(wat.contains('"Options#get:onlyIf()"'), 'the parent getter');
    isTrue(wat.contains('"BucketOptions#set:onlyIf(externref)"'), 'the subclass setter');
    isTrue(wat.contains('"Options#set:onlyIf(externref | null)"'), 'the parent setter');
  });

  test('an Option<T> crosses as the IR\'s T?', (ctx) => {
    let wat = compileWat('tw-option');
    for (let (name, sig) in [
      ('Map#find<f64>(str)', '(param externref) (param externref) (result i32) (result f64)'),
      ('Map#find<Host>(str)', '(param externref) (param externref) (result externref)'),
      ('Map#find<str>(str)', '(param externref) (param externref) (result externref)'),
      ('Map#find<bool>(str)', '(param externref) (param externref) (result i32)'),
      ('Map#put<f64>(V?)', '(param externref) (param i32) (param f64)'),
      ('Map#put<str>(V?)', '(param externref) (param externref)'),
      ('Map#put<bool>(V?)', '(param externref) (param i32)'),
      ('Map#put<i32>(V?)', '(param externref) (param i32) (param i32)'),
      ('id<f64?>(T)', '(param i32) (param f64) (result i32) (result f64)'),
      ('resolve<void>', '(param externref)'),
    ]) {
      isTrue(importsAt(wat, name, sig), `${name} imports as ${sig}`);
    }
  });

  test('an imported global only unreached code names', (ctx) => {
    compileWat('unreached-imported-global');
  });

  test('@spelling names a class or enum in templated imports', (ctx) => {
    let wat = compileWat('tw-spelling');
    for (let want in [
      '"id<WebAssembly.Module>(T)"',
      '"id<node:fs.Stats<f64>>(T)"',
      '"id<Plain>(T)"',
      '"id<Temporal.Unit>(T)"',
      '"id<Color>(T)"',
    ]) {
      isTrue(wat.contains(want), `missing ${want}`);
    }
  });

  test('@export names a Wasm export', (ctx) => {
    let wat = compileWat('export-name');
    isTrue(wat.contains('(export "default.fetch(Request,Env,ExecutionContext)"'), 'the fetch export');
    isTrue(wat.contains('(export "version()"'), 'the version export');
    isTrue(!wat.contains('(export "fetch"'), 'no export under the Zena name');
  });

  test('a tw export crosses as a tw import does', (ctx) => {
    let wat = compileWat('tw-export');
    for (let (name, func, sig) in [
      ('greet(str)', 'greet$tw', '(param externref) (result externref)'),
      ('twice(f64?)', 'twice$tw', '(param i32) (param f64) (result i32) (result f64)'),
      ('name(bool)', 'name$tw', '(param i32) (result externref)'),
    ]) {
      isTrue(exportsAt(wat, name, func, sig), `${name} exports as ${sig}`);
    }
  });

  test('@export names a Wasm export in a library too', (ctx) => {
    let wat = compileWat('export-name-library');
    isTrue(wat.contains('(export "tw:call:fn(f64)"'), 'the library export');
  });
});
