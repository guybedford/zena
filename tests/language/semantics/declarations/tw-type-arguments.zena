// @mode: check
// A templated `tw` import's type arguments name IR types, so each must
// have a spelling, and one whose values cross must cross as the type it
// spells: a host type, a scalar, a String, an enum.
@external("tw:js/global", "id<{T}>(T)", "tw")
declare function id<T>(value: T): T;

@external("tw:js/global", "Box.new<{T}>()", "tw")
declare function boxNew<T>(): Box<T>;

export extension class Box<T> on externref {}

@external("m", "plain<{T}>(T)")
declare function plain<T>(value: T): T;

class Point {
  x: i32;
  new(x: i32) : x = x;
}

export extension class Host on externref {}

export enum Unit { Day }

interface Shape {}

export function main(p: Point, ps: array<Point>, h: Host, s: Shape): void {
  id<Point>(p); // @error: The type argument 'Point' for '{T}' of 'id' is the Zena class 'Point', not a host type, so it can't cross a tw import.
  id<array<Point>>(ps); // @error: The type argument 'array<Point>' for '{T}' of 'id' is the Zena class 'Point', not a host type, so it can't cross a tw import.
  id<Shape>(s); // @error: The type argument 'Shape' for '{T}' of 'id' has no ts-gen IR spelling, so it can't cross a tw import.
  id<Host>(h);
  id<Host | null>(h);
  id<String>("a");
  id<Unit>(Unit.Day);
  id<f64>(1.0);
  boxNew<Point>();
  boxNew<Shape>(); // @error: The type argument 'Shape' for '{T}' of 'boxNew' has no ts-gen IR spelling, so it can't cross a tw import.
  plain<Point>(p);
}
